# --- Laravel Core ---
/vendor
/node_modules
/public/storage
/public/build
/public/hot
/storage/*.key
/storage/pail
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# --- Framework Logs & Cache ---
/storage/logs/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
!/storage/logs/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore

# --- CKFinder Cache & Uploads ---
# Cho phép lưu trữ cấu hình tĩnh nhưng bỏ qua các file cache thumbnail động phát sinh
/storage/framework/cache/ckfinder/*
!/storage/framework/cache/ckfinder/.gitignore

# --- Environment Files & Backups ---
.env
.env.backup
.env.production
*.sql
*.sqlite

# --- IDEs & System Files ---
.idea/
.vscode/
.zed/
.fleet/
.DS_Store
Thumbs.db
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log

# --- Project-Specific Tools ---
/.codebase
.codebase/
/_codebase
_codebase/
